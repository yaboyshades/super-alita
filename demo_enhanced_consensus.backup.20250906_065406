import argparse
import asyncio
import os
import sys
from pathlib import Path

# Add src to path for imports
sys.path.insert(0, str(Path(__file__).parent / "src"))

# Feature flags for different consensus scenarios
AVAILABLE_FEATURES = {
    "weighted_vote": "Test weighted voting consensus algorithm",
    "confidence_scoring": "Test confidence-based consensus selection",
    "semantic_similarity": "Test semantic similarity clustering",
    "ensemble_ranking": "Test multi-factor ensemble ranking",
    "simple_vote": "Test basic majority voting",
    "temperature_diversity": "Test temperature-based sample diversity",
    "model_comparison": "Compare different LLM models",
    "batch_processing": "Test batch consensus processing",
    "error_handling": "Test error scenarios and recovery",
    "performance_metrics": "Measure consensus performance",
}

DEFAULT_FEATURES = ["weighted_vote", "confidence_scoring", "semantic_similarity"]


def create_parser():
    """Create argument parser for Enhanced Consensus Demo."""
    parser = argparse.ArgumentParser(
        description="Enhanced Consensus Demo - Feature-Flagged Testing",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""
Available Features:
{chr(10).join(f"  {name}: {desc}" for name, desc in AVAILABLE_FEATURES.items())}

Examples:
  python demo_enhanced_consensus.py
  python demo_enhanced_consensus.py --features weighted_vote confidence_scoring
  python demo_enhanced_consensus.py --all-features
  python demo_enhanced_consensus.py --prompt "Explain quantum computing"
        """,
    )

    parser.add_argument(
        "--features",
        nargs="*",
        choices=list(AVAILABLE_FEATURES.keys()),
        default=DEFAULT_FEATURES,
        help="Features to test (default: weighted_vote, confidence_scoring, semantic_similarity)",
    )

    parser.add_argument(
        "--all-features",
        action="store_true",
        help="Enable all available features for comprehensive testing",
    )

    parser.add_argument(
        "--prompt",
        default="Explain the benefits of test-driven development in Python",
        help="Test prompt for consensus generation",
    )

    parser.add_argument(
        "--model",
        default=os.getenv("SUPER_ALITA_MODEL", "llama3.2:3b"),
        help="LLM model to use for consensus",
    )

    parser.add_argument(
        "--samples",
        type=int,
        default=3,
        help="Number of samples for consensus (default: 3)",
    )

    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Enable verbose output with detailed metrics",
    )

    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be tested without executing",
    )

    return parser


async def test_weighted_vote(provider, prompt: str, samples: int, verbose: bool):
    """Test weighted voting consensus algorithm."""
    print("🔄 Testing Weighted Vote Consensus...")

    try:
        result = await provider.consensus_sampling(
            prompt=prompt,
            num_samples=samples,
            method="weighted_vote",
            temperature=0.7,
            confidence_threshold=0.6,
        )

        print(f"✅ Weighted Vote Result: {result['consensus'][:100]}...")
        if verbose:
            print(f"   Confidence: {result.get('confidence', 'N/A')}")
            print(f"   Method: {result.get('method', 'N/A')}")
            print(f"   Samples: {len(result.get('samples', []))}")

        return result

    except Exception as e:
        print(f"❌ Weighted Vote Failed: {e}")
        return None


