async def test_temperature_diversity(
    provider, prompt: str, samples: int, verbose: bool
):
    """Test temperature-based sample diversity."""
    print("🌡️  Testing Temperature Diversity...")

    try:
        # Test with different temperature ranges
        temperatures = [0.3, 0.7, 1.0]
        results = []

        for temp in temperatures:
            result = await provider.consensus_sampling(
                prompt=prompt,
                num_samples=samples,
                method="weighted_vote",
                temperature=temp,
                temperature_range=0.2,
            )
            results.append((temp, result))

        print(f"✅ Temperature Diversity: {len(results)} variants tested")
        if verbose:
            for temp, result in results:
                print(f"   Temp {temp}: {result['consensus'][:50]}...")

        return results

    except Exception as e:
        print(f"❌ Temperature Diversity Failed: {e}")
        return None


async def test_performance_metrics(provider, prompt: str, samples: int, verbose: bool):
    """Measure consensus performance metrics."""
    print("📊 Testing Performance Metrics...")

    import time

    try:
        start_time = time.time()

        result = await provider.consensus_sampling(
            prompt=prompt, num_samples=samples, method="weighted_vote", temperature=0.7
        )

        end_time = time.time()
        duration = end_time - start_time

        print("✅ Performance Test Complete")
        print(f"   Duration: {duration:.2f}s")
        print(f"   Samples/sec: {samples/duration:.2f}")

        if verbose:
            print(f"   Total samples: {samples}")
            print(f"   Result length: {len(result.get('consensus', ''))}")

        return {
            "duration": duration,
            "samples_per_sec": samples / duration,
            "result": result,
        }

    except Exception as e:
        print(f"❌ Performance Metrics Failed: {e}")
        return None


# Feature test mapping
FEATURE_TESTS = {
    "weighted_vote": test_weighted_vote,
    "confidence_scoring": test_confidence_scoring,
    "semantic_similarity": test_semantic_similarity,
    "ensemble_ranking": test_ensemble_ranking,
    "simple_vote": test_simple_vote,
    "temperature_diversity": test_temperature_diversity,
    "performance_metrics": test_performance_metrics,
}


async def main():
    """Main demo function."""
    parser = create_parser()
    args = parser.parse_args()

    # Handle all-features flag
    if args.all_features:
        args.features = list(AVAILABLE_FEATURES.keys())

    print("🚀 Enhanced Consensus Demo")
    print(f"   Model: {args.model}")
    print(f"   Samples: {args.samples}")
    print(f"   Features: {', '.join(args.features)}")
    print(f"   Prompt: {args.prompt[:50]}...")
    print()

    if args.dry_run:
        print("🔍 DRY RUN - Would test the following features:")
        for feature in args.features:
            print(f"   ✓ {feature}: {AVAILABLE_FEATURES.get(feature, 'Unknown')}")
        return

    # Initialize Enhanced Consensus Provider
    try:
        from abilities.enhanced_consensus_ability import EnhancedConsensusProvider

        config = {
            "base_url": "http://localhost:11434/v1",
            "model_name": args.model,
            "timeout": 60,
        }

        provider = EnhancedConsensusProvider(config)
        print("✅ Enhanced Consensus Provider initialized")

    except ImportError as e:
        print(f"❌ Failed to import Enhanced Consensus Provider: {e}")
        print("   Make sure Super-Alita is properly installed")
        return
    except Exception as e:
        print(f"❌ Failed to initialize provider: {e}")
        return

    # Run selected feature tests
    results = {}

    for feature in args.features:
        if feature in FEATURE_TESTS:
            print(f"\n--- Testing {feature} ---")
            test_func = FEATURE_TESTS[feature]
            result = await test_func(provider, args.prompt, args.samples, args.verbose)
            results[feature] = result
        else:
            print(f"⚠️  Unknown feature: {feature}")

    # Summary
    print("\n📋 Demo Summary:")
    successful = sum(1 for r in results.values() if r is not None)
    total = len(results)
    print(f"   Successful: {successful}/{total}")

    if args.verbose and results:
        print(
            f"   Results available for: {', '.join(k for k, v in results.items() if v is not None)}"
        )


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n👋 Demo cancelled by user")
    except Exception as e:
        print(f"❌ Demo failed: {e}")
        sys.exit(1)
