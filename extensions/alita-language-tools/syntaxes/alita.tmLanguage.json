{
  "scopeName": "source.alita",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#abilities" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.alita", "match": "//.*$" },
        { "name": "comment.block.alita", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.alita", "begin": "\"", "end": "\"", "patterns": [{ "match": "\\\\." }] },
        { "name": "string.quoted.single.alita", "begin": "'", "end": "'", "patterns": [{ "match": "\\\\." }] }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.alita", "match": "\\b(if|else|for|while|return|async|await|try|catch|raise)\\b" }
      ]
    },
    "abilities": {
      "patterns": [
        { "name": "entity.name.function.ability.alita", "match": "\\bability\\s+([A-Za-z_][A-Za-z0-9_]*)\\b" }
      ]
    }
  }
}
