{
  "version": "1.0.0",
  "enterprise_config": {
    "name": "super-alita-enterprise",
    "description": "Enterprise configuration for Super Alita multi-agent system",
    "trae_integration": {
      "enabled": true,
      "reverse_proxy": {
        "load_balancing": "weighted_round_robin",
        "health_checks": {
          "interval": "30s",
          "timeout": "5s",
          "retries": 3
        },
        "rate_limiting": {
          "requests_per_minute": 1000,
          "burst_size": 100
        }
      },
      "ssl_termination": {
        "enabled": true,
        "certificate_source": "letsencrypt",
        "min_tls_version": "1.2"
      }
    },
    "service_discovery": {
      "backend": "consul",
      "health_check_endpoints": [
        "/health/simple",
        "/healthz"
      ],
      "tags": [
        "ai-agent",
        "sdd-compliant",
        "constitutional-validated"
      ]
    },
    "middleware": [
      {
        "name": "constitutional_validator",
        "config": {
          "min_score": 0.75,
          "enforce_on_routes": [
            "/sdd/*",
            "/constitutional/*"
          ]
        }
      },
      {
        "name": "rate_limiter",
        "config": {
          "global_limit": "1000/minute",
          "per_user_limit": "100/minute"
        }
      },
      {
        "name": "auth",
        "config": {
          "jwt_secret_env": "JWT_SECRET",
          "token_expiry": "24h"
        }
      }
    ],
    "scaling": {
      "auto_scaling": {
        "enabled": true,
        "min_instances": 2,
        "max_instances": 20,
        "scale_up_threshold": 70,
        "scale_down_threshold": 30,
        "cooldown_period": "5m"
      },
      "geographic_distribution": {
        "enabled": true,
        "regions": [
          {
            "name": "us-east-1",
            "weight": 40,
            "min_instances": 1
          },
          {
            "name": "eu-west-1",
            "weight": 35,
            "min_instances": 1
          },
          {
            "name": "ap-southeast-1",
            "weight": 25,
            "min_instances": 1
          }
        ]
      }
    },
    "monitoring": {
      "metrics_collection": {
        "enabled": true,
        "interval": "15s",
        "custom_metrics": [
          "sdd_validation_latency",
          "constitutional_compliance_score",
          "agent_orchestration_success_rate"
        ]
      },
      "alerting": {
        "channels": [
          {
            "name": "slack",
            "webhook_env": "SLACK_WEBHOOK_URL"
          },
          {
            "name": "pagerduty",
            "integration_key_env": "PAGERDUTY_KEY"
          }
        ],
        "rules": [
          {
            "name": "high_constitutional_violation_rate",
            "condition": "constitutional_violations > 5",
            "duration": "5m",
            "severity": "critical"
          },
          {
            "name": "sdd_validation_failure",
            "condition": "sdd_validation_success_rate < 0.95",
            "duration": "10m",
            "severity": "warning"
          }
        ]
      }
    },
    "security": {
      "network": {
        "firewall_rules": [
          {
            "source": "0.0.0.0/0",
            "destination_port": "443",
            "protocol": "tcp",
            "action": "allow"
          },
          {
            "source": "10.0.0.0/8",
            "destination_port": "8080",
            "protocol": "tcp",
            "action": "allow"
          }
        ],
        "ddos_protection": {
          "enabled": true,
          "threshold": "10000/minute"
        }
      },
      "application": {
        "cors": {
          "allowed_origins": [
            "https://super-alita.dev",
            "https://*.super-alita.dev"
          ],
          "allowed_methods": ["GET", "POST", "PUT", "DELETE"],
          "allowed_headers": ["Authorization", "Content-Type"]
        },
        "content_security_policy": {
          "default_src": "'self'",
          "script_src": "'self' 'unsafe-inline'",
          "style_src": "'self' 'unsafe-inline'"
        }
      }
    }
  }
}