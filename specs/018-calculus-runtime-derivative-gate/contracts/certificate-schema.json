{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://super-alita.dev/schemas/calculus-gate/certificate.json",
  "title": "Calculus Gate Certificate",
  "description": "Performance certificate with runtime derivative analysis",
  "type": "object",
  "required": [
    "function_name",
    "build_id",
    "analysis_timestamp",
    "certificate_version",
    "sample_set",
    "first_derivatives",
    "second_derivatives",
    "lipschitz_constant",
    "passes_slope_gate",
    "passes_curvature_gate",
    "passes_lipschitz_gate",
    "overall_compliance",
    "certificate_grade"
  ],
  "properties": {
    "function_name": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
      "description": "Python function name"
    },
    "build_id": {
      "type": "string",
      "minLength": 7,
      "maxLength": 40,
      "description": "Git commit hash or build identifier"
    },
    "analysis_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of analysis"
    },
    "certificate_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "default": "1.0",
      "description": "Certificate schema version"
    },
    "sample_set": {
      "$ref": "#/definitions/RuntimeSampleSet"
    },
    "fitted_curve_params": {
      "type": "object",
      "description": "Spline coefficients or fit parameters"
    },
    "first_derivatives": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "description": "df/dn values at each input size"
    },
    "second_derivatives": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "description": "d²f/dn² values at each input size"
    },
    "lipschitz_constant": {
      "type": "number",
      "minimum": 0,
      "description": "Maximum |f(x1)-f(x2)|/|x1-x2|"
    },
    "derivative_confidence_intervals": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2,
        "description": "[lower_bound, upper_bound]"
      },
      "description": "95% confidence intervals for first derivatives"
    },
    "curvature_confidence_intervals": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "description": "95% confidence intervals for second derivatives"
    },
    "bootstrap_iterations": {
      "type": "integer",
      "minimum": 100,
      "default": 1000,
      "description": "Number of bootstrap samples used"
    },
    "slope_violations": {
      "type": "array",
      "items": {
        "type": "array",
        "items": [
          {
            "type": "integer",
            "minimum": 1,
            "description": "input_size"
          },
          {
            "type": "number",
            "description": "df_dn_value"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "description": "Input sizes where |df/dn| exceeds limit"
    },
    "curvature_violations": {
      "type": "array",
      "items": {
        "type": "array",
        "items": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "number"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "description": "Input sizes where |d²f/dn²| exceeds limit"
    },
    "lipschitz_violation": {
      "type": "boolean",
      "description": "Whether Lipschitz constant exceeds limit"
    },
    "slope_limit": {
      "type": "number",
      "minimum": 0,
      "description": "Configured slope threshold"
    },
    "curvature_limit": {
      "type": "number",
      "minimum": 0,
      "description": "Configured curvature threshold"
    },
    "lipschitz_limit": {
      "type": "number",
      "minimum": 0,
      "description": "Configured Lipschitz threshold"
    },
    "passes_slope_gate": {
      "type": "boolean",
      "description": "Whether slope gate passed"
    },
    "passes_curvature_gate": {
      "type": "boolean",
      "description": "Whether curvature gate passed"
    },
    "passes_lipschitz_gate": {
      "type": "boolean",
      "description": "Whether Lipschitz gate passed"
    },
    "overall_compliance": {
      "type": "boolean",
      "description": "Whether all gates passed"
    },
    "certificate_grade": {
      "type": "string",
      "enum": ["A", "B", "F"],
      "description": "Overall performance grade"
    },
    "fitting_method": {
      "type": "string",
      "enum": ["cubic_spline", "savgol_fallback", "linear_fallback"],
      "description": "Curve fitting method used"
    },
    "fitting_quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "R² or goodness-of-fit measure"
    },
    "noise_handling_applied": {
      "type": "boolean",
      "description": "Whether noise mitigation was applied"
    },
    "baseline_comparison": {
      "type": ["string", "null"],
      "description": "Previous certificate ID for comparison"
    },
    "trend_analysis": {
      "type": "object",
      "description": "Trend indicators vs baseline"
    }
  },
  "definitions": {
    "RuntimeSampleSet": {
      "type": "object",
      "required": [
        "target_function",
        "build_id",
        "measurement_timestamp",
        "input_sizes",
        "wall_times",
        "cpu_times",
        "memory_peaks",
        "memory_deltas"
      ],
      "properties": {
        "target_function": {
          "type": "string",
          "description": "Function name"
        },
        "build_id": {
          "type": "string",
          "description": "Build or commit identifier"
        },
        "measurement_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When measurements were taken"
        },
        "input_sizes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 3,
          "description": "Input sizes tested (strictly increasing)"
        },
        "wall_times": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "description": "Wall clock times in seconds"
        },
        "cpu_times": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "description": "CPU times in seconds"
        },
        "memory_peaks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Peak memory usage in bytes"
        },
        "memory_deltas": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Memory allocated during execution"
        },
        "warmup_runs": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of warmup runs per sample"
        },
        "measurement_conditions": {
          "type": "object",
          "description": "System state during measurement"
        },
        "measurement_noise": {
          "type": "number",
          "minimum": 0,
          "description": "Coefficient of variation"
        },
        "convergence_achieved": {
          "type": "boolean",
          "description": "Whether measurements stabilized"
        },
        "outliers_removed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of outliers removed"
        }
      }
    }
  }
}
