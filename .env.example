# .env.example
# Copy to .env and customize

# ===== Unified System Feature Flags =====
ENABLE_GITHUB_DEMO=0
ENABLE_PERPLEXICA_DEMO=0
ENABLE_AUTOGEN_DEMO=0
APP_PORT=8080
APP_HOST=0.0.0.0

# ===== Microservices Configuration =====
# Consensus Service
CONSENSUS_SERVICE_MODE=local
CONSENSUS_GRPC_URL=127.0.0.1:50051
CONSENSUS_GRPC_BIND=0.0.0.0:50051

# Redis Event Bus
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
USE_REDIS_EVENT_BUS=false

# ===== Execution Guardrails =====
REUG_MAX_TOOL_CALLS=5
REUG_EXEC_TIMEOUT_S=20.0
REUG_MODEL_STREAM_TIMEOUT_S=60.0
REUG_EXEC_MAX_RETRIES=1
REUG_RETRY_BASE_MS=250
REUG_SCHEMA_ENFORCE=true

# ===== Persistence & Logging =====
REUG_EVENT_LOG_DIR=./logs/events
REUG_TOOL_REGISTRY_DIR=./tools_registry

# ===== LLM Provider (choose one) =====
# OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-gemini-key-here
# ANTHROPIC_API_KEY=your-claude-key-here
# Local Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# LLM_MODEL=ollama:gpt-oss:20b

# GPT-OSS via OpenAI-compatible gateway (not this runtime)
# SUPER_ALITA_BASE_URL=http://127.0.0.1:8081
# SUPER_ALITA_API_KEY=your_local_gateway_key
# LLM_MODEL=gpt-oss:20b

# ===== Puter Cloud Environment =====
# Default remote instance
PUTER_BASE_URL=https://puter.com
# PUTER_API_KEY=your_puter_api_key_here
# PUTER_WORKSPACE_ID=default
# For local hosting, override base URL:
# PUTER_BASE_URL=http://localhost:4100

# ===== General =====
PYTHONPATH=./src

# ACP Server Configuration
ACP_HOST=0.0.0.0
ACP_PORT=8000
ACP_REQUIRE_AUTH=false
ACP_API_KEY=test-key
LOG_LEVEL=INFO

# Search API Keys (optional)
SERPAPI_KEY=your_serpapi_key_here
BING_API_KEY=your_bing_key_here
GOOGLE_CSE_ID=your_google_cse_id
GOOGLE_API_KEY=your_google_api_key
YOUTUBE_API_KEY=your_youtube_key
WOLFRAM_APP_ID=your_wolfram_id

# LLM Configuration
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400

# ===== DeepCode Integration =====
# DEEPCODE_API_URL=https://deepcode.mycompany.com
# DEEPCODE_API_KEY=your_deepcode_key
# DEEPCODE_TIMEOUT_S=60
# DEEPCODE_LATEST_PATH=./logs/deepcode_latest.json
