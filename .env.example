# Super Alita Configuration Example
# Copy this to .env and customize

# Core Configuration
SUPER_ALITA_DEV=false
REUG_LOG_LEVEL=INFO
REUG_LOG_DIR=./logs

# LLM Configuration
LLM_MODEL=ollama:gpt-oss:20b
OLLAMA_HOST=http://127.0.0.1:11434

# API Security (optional)
ALITA_REQUIRE_API_KEY=false
ALITA_API_KEY=your_api_key_here
ALITA_ADMIN_KEY=your_admin_key_here

# Rate Limiting (optional)
ALITA_RATE_LIMIT_ENABLED=false
ALITA_RATE_LIMIT=60
ALITA_RATE_WINDOW=60
ALITA_REDIS_URL=redis://localhost:6379

# GitHub Integration (optional)
GITHUB_TOKEN=your_github_token_here
ENABLE_GITHUB_DEMO=false

# Feature Flags
ENABLE_ENHANCED_CONSENSUS=true
ENABLE_AUTOGEN_DEMO=false
ENABLE_PERPLEXICA_DEMO=false

# Advanced Features
ALITA_ENABLE_Z3=false
CONSENSUS_SERVICE_MODE=local
ALITA_SIMPLE_CHAT_STREAM=false

# Research Mode (requires research components)
RESEARCH_ENABLED=false
CONSTITUTIONAL_LLM_MODEL=microsoft/DialoGPT-medium
MEMORY_CONSOLIDATION_INTERVAL=24

# MCP Integration
MCP_BROADCAST_ENABLED=false

# CORS Configuration
CORS_ALLOW_ORIGINS=*