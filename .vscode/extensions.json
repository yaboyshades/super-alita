    // "alita.deep-research",   // Research capabilities
    // "alita.prompt-optimizer" // Conditional optimization
  ],
  
  "unwantedRecommendations": [
    // Deprecated or conflicting extensions
    "alita.mangle-integration",  // Replaced by alita.language-tools
    "alita.refactor-tools",      // Merged into alita.language-tools
    
    // Extensions that conflict with our setup
    "ms-python.flake8",          // Using Ruff instead
    "ms-python.pylint",          // Using Ruff instead
    "formulahendry.auto-rename-tag", // Can conflict with language servers
    
    // Heavy extensions that may impact performance
    "ms-vscode.vscode-json",     // Basic JSON support is sufficient
