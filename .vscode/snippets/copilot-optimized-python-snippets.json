{
  "FastAPI Service with Dependencies": {
    "prefix": ["service", "fastapi-service"],
    "body": [
      "from fastapi import APIRouter, Depends, HTTPException",
      "from sqlalchemy.orm import Session",
      "from typing import List",
      "",
      "from ..database import get_db",
      "from ..models import ${1:ModelName}",
      "from ..schemas import ${1:ModelName}Create, ${1:ModelName}Response",
      "",
      "router = APIRouter(prefix=\"/${2:endpoint}\", tags=[\"${2:endpoint}\"])",
      "",
      "@router.post(\"/\", response_model=${1:ModelName}Response)",
      "async def create_${2:endpoint}(",
      "    ${2:endpoint}_data: ${1:ModelName}Create,",
      "    db: Session = Depends(get_db)",
      "):",
      "    \"\"\"Create a new ${2:endpoint}\"\"\"",
      "    db_${2:endpoint} = ${1:ModelName}(**${2:endpoint}_data.dict())",
      "    db.add(db_${2:endpoint})",
      "    db.commit()",
      "    db.refresh(db_${2:endpoint})",
      "    return db_${2:endpoint}",
      "",
      "@router.get(\"/\", response_model=List[${1:ModelName}Response])",
      "async def list_${2:endpoint}(db: Session = Depends(get_db)):",
      "    \"\"\"List all ${2:endpoint}\"\"\"",
      "    return db.query(${1:ModelName}).all()",
      "",
      "$0"
    ],
    "description": "Complete FastAPI service with CRUD operations following project patterns"
  },
  "Custom Exception with Logging": {
    "prefix": ["exception", "custom-error"],
    "body": [
      "import logging",
      "from typing import Optional",
      "",
      "logger = logging.getLogger(__name__)",
      "",
      "class ${1:ExceptionName}(Exception):",
      "    \"\"\"${2:Exception description}\"\"\"",
      "    ",
      "    def __init__(",
      "        self, ",
      "        message: str,",
      "        error_code: Optional[str] = None,",
      "        details: Optional[dict] = None",
      "    ):",
      "        self.message = message",
      "        self.error_code = error_code or \"${3:DEFAULT_ERROR}\"",
      "        self.details = details or {}",
      "        ",
      "        logger.error(",
      "            f\"${1:ExceptionName}: {message}\",",
      "            extra={",
      "                \"error_code\": self.error_code,",
      "                \"details\": self.details",
      "            }",
      "        )",
      "        super().__init__(self.message)",
      "$0"
    ],
    "description": "Custom exception with structured logging following project patterns"
  },
  "Pytest Fixture with Database": {
    "prefix": ["pytest-fixture", "test-fixture"],
    "body": [
      "import pytest",
      "from sqlalchemy.orm import Session",
      "from fastapi.testclient import TestClient",
      "",
      "from ..database import get_db",
      "from ..main import app",
      "from ..models import ${1:ModelName}",
      "",
      "@pytest.fixture",
      "def client(db_session: Session):",
      "    \"\"\"Test client with database dependency override\"\"\"",
      "    def override_get_db():",
      "        yield db_session",
      "    ",
      "    app.dependency_overrides[get_db] = override_get_db",
      "    with TestClient(app) as client:",
      "        yield client",
      "    app.dependency_overrides.clear()",
      "",
      "@pytest.fixture",
      "def sample_${2:model_name}(db_session: Session) -> ${1:ModelName}:",
      "    \"\"\"Create a sample ${2:model_name} for testing\"\"\"",
      "    ${2:model_name} = ${1:ModelName}(",
      "        ${3:field}=\"${4:test_value}\"",
      "    )",
      "    db_session.add(${2:model_name})",
      "    db_session.commit()",
      "    db_session.refresh(${2:model_name})",
      "    return ${2:model_name}",
      "$0"
    ],
    "description": "Pytest fixture following project database testing patterns"
  },
  "API Endpoint Test Suite": {
    "prefix": ["test-api", "api-test"],
    "body": [
      "import pytest",
      "from fastapi.testclient import TestClient",
      "from sqlalchemy.orm import Session",
      "",
      "def test_create_${1:endpoint}(client: TestClient, db_session: Session):",
      "    \"\"\"Test creating a new ${1:endpoint}\"\"\"",
      "    payload = {",
      "        \"${2:field}\": \"${3:test_value}\"",
      "    }",
      "    ",
      "    response = client.post(\"/${1:endpoint}/\", json=payload)",
      "    ",
      "    assert response.status_code == 200",
      "    data = response.json()",
      "    assert data[\"${2:field}\"] == \"${3:test_value}\"",
      "    assert \"id\" in data",
      "",
      "def test_list_${1:endpoint}(client: TestClient, sample_${1:endpoint}):",
      "    \"\"\"Test listing ${1:endpoint}\"\"\"",
      "    response = client.get(\"/${1:endpoint}/\")",
      "    ",
      "    assert response.status_code == 200",
      "    data = response.json()",
      "    assert isinstance(data, list)",
      "    assert len(data) >= 1",
      "",
      "def test_${1:endpoint}_not_found(client: TestClient):",
      "    \"\"\"Test ${1:endpoint} not found scenario\"\"\"",
      "    response = client.get(\"/${1:endpoint}/999999\")",
      "    assert response.status_code == 404",
      "$0"
    ],
    "description": "Complete API test suite following project testing conventions"
  },
  "Pydantic Settings Class": {
    "prefix": ["settings", "config"],
    "body": [
      "from pydantic import BaseSettings, validator",
      "from typing import Optional",
      "import os",
      "",
      "class ${1:Settings}(BaseSettings):",
      "    \"\"\"Application settings with validation\"\"\"",
      "    ",
      "    # Database",
      "    database_url: str",
      "    database_pool_size: int = 10",
      "    ",
      "    # Security",
      "    secret_key: str",
      "    jwt_expiration_hours: int = 24",
      "    ",
      "    # External APIs",
      "    ${2:api_name}_base_url: Optional[str] = None",
      "    ${2:api_name}_api_key: Optional[str] = None",
      "    ${2:api_name}_timeout_seconds: int = 30",
      "    ",
      "    # Application",
      "    debug: bool = False",
      "    log_level: str = \"INFO\"",
      "    ",
      "    @validator('database_url')",
      "    def validate_database_url(cls, v):",
      "        if not v.startswith(('postgresql://', 'sqlite://', 'mysql://')):",
      "            raise ValueError('Invalid database URL format')",
      "        return v",
      "    ",
      "    @validator('log_level')",
      "    def validate_log_level(cls, v):",
      "        valid_levels = ['DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL']",
      "        if v.upper() not in valid_levels:",
      "            raise ValueError(f'Log level must be one of: {valid_levels}')",
      "        return v.upper()",
      "    ",
      "    class Config:",
      "        env_file = '.env'",
      "        case_sensitive = False",
      "",
      "# Global settings instance",
      "settings = ${1:Settings}()",
      "$0"
    ],
    "description": "Pydantic settings with validation following project patterns"
  },
  "SQLAlchemy Model with Audit": {
    "prefix": ["sqlmodel", "model"],
    "body": [
      "from sqlalchemy import Column, Integer, String, DateTime, ForeignKey, Boolean",
      "from sqlalchemy.orm import relationship",
      "from sqlalchemy.sql import func",
      "from ..database import Base",
      "",
      "class ${1:ModelName}(Base):",
      "    \"\"\"${2:Model description}\"\"\"",
      "    __tablename__ = \"${3:table_name}\"",
      "    ",
      "    # Primary key",
      "    id = Column(Integer, primary_key=True, index=True)",
      "    ",
      "    # Core fields",
      "    ${4:name} = Column(String, nullable=False, index=True)",
      "    ${5:description} = Column(String, nullable=True)",
      "    ",
      "    # Status and flags",
      "    is_active = Column(Boolean, default=True)",
      "    ",
      "    # Audit fields",
      "    created_at = Column(DateTime(timezone=True), server_default=func.now())",
      "    updated_at = Column(DateTime(timezone=True), onupdate=func.now())",
      "    ",
      "    # Foreign keys",
      "    # ${6:related}_id = Column(Integer, ForeignKey(\"${7:related_table}.id\"))",
      "    ",
      "    # Relationships",
      "    # ${6:related} = relationship(\"${8:RelatedModel}\", back_populates=\"${9:back_ref}\")",
      "    ",
      "    def __repr__(self):",
      "        return f\"<${1:ModelName}(id={self.id}, ${4:name}={self.${4:name}})>\"",
      "    ",
      "    def to_dict(self):",
      "        \"\"\"Convert model to dictionary\"\"\"",
      "        return {",
      "            \"id\": self.id,",
      "            \"${4:name}\": self.${4:name},",
      "            \"${5:description}\": self.${5:description},",
      "            \"is_active\": self.is_active,",
      "            \"created_at\": self.created_at.isoformat() if self.created_at else None,",
      "            \"updated_at\": self.updated_at.isoformat() if self.updated_at else None,",
      "        }",
      "$0"
    ],
    "description": "SQLAlchemy model with audit fields and relationships"
  },
  "Async Context Manager": {
    "prefix": ["async-context", "context-manager"],
    "body": [
      "from contextlib import asynccontextmanager",
      "from typing import AsyncGenerator, Optional",
      "import logging",
      "",
      "logger = logging.getLogger(__name__)",
      "",
      "@asynccontextmanager",
      "async def ${1:context_name}(",
      "    ${2:param}: ${3:ParamType},",
      "    timeout: Optional[int] = None",
      ") -> AsyncGenerator[${4:ReturnType}, None]:",
      "    \"\"\"${5:Context manager description}\"\"\"",
      "    ${6:resource} = None",
      "    try:",
      "        logger.info(f\"Opening ${1:context_name} context for {${2:param}}\")",
      "        ",
      "        # Setup",
      "        ${6:resource} = await ${7:setup_resource}(${2:param}, timeout=timeout)",
      "        ",
      "        yield ${6:resource}",
      "        ",
      "    except Exception as e:",
      "        logger.error(f\"Error in ${1:context_name} context: {e}\")",
      "        raise",
      "    finally:",
      "        # Cleanup",
      "        if ${6:resource}:",
      "            try:",
      "                await ${8:cleanup_resource}(${6:resource})",
      "                logger.info(f\"Successfully closed ${1:context_name} context\")",
      "            except Exception as e:",
      "                logger.error(f\"Error cleaning up ${1:context_name}: {e}\")",
      "$0"
    ],
    "description": "Async context manager with logging and error handling"
  },
  "Performance Monitor Decorator": {
    "prefix": ["perf-monitor", "timing"],
    "body": [
      "import time",
      "import functools",
      "import logging",
      "from typing import Callable, Any",
      "",
      "logger = logging.getLogger(__name__)",
      "",
      "def monitor_performance(threshold_seconds: float = 1.0):",
      "    \"\"\"Decorator to monitor function performance\"\"\"",
      "    def decorator(func: Callable) -> Callable:",
      "        @functools.wraps(func)",
      "        async def async_wrapper(*args, **kwargs) -> Any:",
      "            start_time = time.perf_counter()",
      "            try:",
      "                result = await func(*args, **kwargs)",
      "                return result",
      "            finally:",
      "                execution_time = time.perf_counter() - start_time",
      "                ",
      "                if execution_time > threshold_seconds:",
      "                    logger.warning(",
      "                        f\"Slow execution: {func.__name__} took {execution_time:.3f}s\",",
      "                        extra={",
      "                            \"function\": func.__name__,",
      "                            \"execution_time\": execution_time,",
      "                            \"threshold\": threshold_seconds",
      "                        }",
      "                    )",
      "                else:",
      "                    logger.debug(f\"{func.__name__} executed in {execution_time:.3f}s\")",
      "        ",
      "        @functools.wraps(func)",
      "        def sync_wrapper(*args, **kwargs) -> Any:",
      "            start_time = time.perf_counter()",
      "            try:",
      "                result = func(*args, **kwargs)",
      "                return result",
      "            finally:",
      "                execution_time = time.perf_counter() - start_time",
      "                ",
      "                if execution_time > threshold_seconds:",
      "                    logger.warning(",
      "                        f\"Slow execution: {func.__name__} took {execution_time:.3f}s\"",
      "                    )",
      "        ",
      "        return async_wrapper if asyncio.iscoroutinefunction(func) else sync_wrapper",
      "    return decorator",
      "$0"
    ],
    "description": "Performance monitoring decorator for sync and async functions"
  },
