{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REUG Subsystem Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "runtime",
    "version",
    "feature_flag",
    "constraints",
    "artifacts",
    "interfaces",
    "events",
    "tests",
    "observability",
    "rollout"
  ],
  "properties": {
    "module": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "feature_flag": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docs", "code", "tests", "manifests"],
      "properties": {
        "docs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python"],
      "properties": {
        "python": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topics"],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "schema"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "levels"],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "logs", "traces", "slos", "alerts"],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "slos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "rollback", "kill_switch"],
      "properties": {
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        },
        "kill_switch": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
