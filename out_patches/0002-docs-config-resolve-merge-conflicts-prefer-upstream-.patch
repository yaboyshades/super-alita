+        return {
+            "plugin_metrics": self._metrics,
+            "policies": policy_stats,
+            "rewards": reward_stats,
+            "rules": rule_stats,
+            "timestamp": time.time()
+        }
+    
+    async def export_data(self) -> Dict[str, Any]:
+        """Export all optimization data for analysis."""
