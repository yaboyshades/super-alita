-    def _calculate_consolidation_penalty(self, rewards: list[float]) -> float:
-        """Calculate penalty based on recent reward history to prevent dominance."""
-        if not rewards:
-            return 0.0
-        recent = rewards[-5:]
-        avg_recent = sum(recent) / len(recent)
-        return 0.1 * avg_recent
