+            "id": "event_3",
+            "type": "tool_call",
+            "user_id": "user123",
+            "session_id": "session_abc",
+            "tool_name": "calculator",
+            "timestamp": datetime.now(UTC).isoformat(),
+        },
+    ]
+
+    # Process events
+    for event in sample_events:
+        await kg_enricher._process_event_for_kg(event)
+
+    # Print statistics
+    stats = kg_enricher.get_enrichment_stats()
