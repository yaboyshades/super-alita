+        plugin_name = tool.get("plugin_name", "unknown_plugin")
+        # tool_name = tool.get('name', 'unknown_tool')  # Currently unused
+
+        if plugin_name in self.plugin_registry:
+            plugin = self.plugin_registry[plugin_name]
