+        response = PerplexicaResponse(
+            query=query,
+            search_mode=search_mode,
+            summary=summary,
+            reasoning=reasoning,
+            sources=search_results,
+            citations=citations,
+            follow_up_questions=follow_ups,
+            confidence_score=self._calculate_confidence(search_results),
+            total_results=len(search_results),
+        )
