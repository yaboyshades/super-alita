+            active_plugins = 0
+            if self.cortex_runtime: active_plugins += 1
+            if self.telemetry_collector: active_plugins += 1
+            if self.knowledge_plugin: active_plugins += 1
+            if self.optimization_plugin: active_plugins += 1
+            
+            system_info = {
