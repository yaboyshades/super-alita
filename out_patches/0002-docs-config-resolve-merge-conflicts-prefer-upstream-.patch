+    await o.advance_phase_if_ready(0.35)
+    await o.advance_phase_if_ready(0.36)
+    await o.advance_phase_if_ready(0.37)
+    await o.advance_phase_if_ready(0.56)
+    await o.advance_phase_if_ready(0.57)
