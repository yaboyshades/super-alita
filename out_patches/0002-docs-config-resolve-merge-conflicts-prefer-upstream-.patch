+"""
+Extended Redis EventBus tests with pluggable serialization.
+
+Tests both JSON and Protobuf wire formats, backpressure handling,
+and Dead Letter Queue functionality.
+"""
+
+import asyncio
+import importlib
+import logging
+import socket
