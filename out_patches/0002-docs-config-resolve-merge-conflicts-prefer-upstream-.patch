-
-        logger.info(f"🔧 Executing {task.title} with {tool} (mode: {self.mode})")
-
-        if self.mode == "shadow":
-            # Shadow mode: simulate execution
-            await asyncio.sleep(0.1)  # Simulate work
-            success_prob = 0.8 + (
-                task.confidence * 0.2
