-
-            # Execute code in safe environment
-            safe_globals = {
-                "__builtins__": {
-                    "len": len,
-                    "str": str,
-                    "int": int,
-                    "float": float,
-                    "dict": dict,
-                    "list": list,
-                    "tuple": tuple,
-                    "Exception": Exception,
-                    "ValueError": ValueError,
-                    "TypeError": TypeError,
-                    "time": time,
