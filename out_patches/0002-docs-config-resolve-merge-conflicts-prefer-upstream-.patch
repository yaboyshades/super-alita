-        transition = FSMTransition(
-            from_state=from_state,
-            to_state=to_state,
-            trigger=trigger,
-            transition_type=transition_type,
-            embedding=embedding,
-            similarity_threshold=similarity_threshold,
-            condition_func=condition_func,
-            priority=priority,
-            metadata=metadata or {},
