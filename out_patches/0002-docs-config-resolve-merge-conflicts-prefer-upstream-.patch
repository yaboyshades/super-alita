+            for i in range(10):
+                success = (i % 3) != 0  # 66% success rate
+                cost = 0.05 + (i * 0.01)  # Increasing cost
+                latency = 1.0 + (i * 0.1)  # Increasing latency
+
+                self.engine.update_bandit_stats(cap_id, success, cost, latency)
