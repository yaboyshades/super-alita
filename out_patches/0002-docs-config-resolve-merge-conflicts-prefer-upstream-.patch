+
+    result1 = await search_tool(query="test query", mode="web")
+    assert not result1.get("_cache_hit", False)
+
+    result2 = await search_tool(query="test query", mode="web")
+    assert result2.get("_cache_hit", False)
+
+
+@pytest.mark.asyncio
