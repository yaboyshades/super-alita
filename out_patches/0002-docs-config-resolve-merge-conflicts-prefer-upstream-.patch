+            "GET", "/api/fs/stat", params={"path": full_path}
+
+        )
+
+    def get_plugin_info(self) -> Dict[str, Any]:
+        return {
+            "name": "PuterPlugin",
+            "version": "1.0.0",
+            "description": "Integration with Puter cloud environment",
+            "capabilities": [
+                "file_io",
+                "process_execution",
+                "directory_management",
+            ],
+        }
+
+
+    @staticmethod
+    def _hmac_sha256_hex(secret: str, body: str) -> str:
+        import hmac
+        import hashlib
+
+        digest = hmac.new(
