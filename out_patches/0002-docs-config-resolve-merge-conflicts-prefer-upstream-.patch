+        row = cursor.fetchone()
+        
+        if not row:
+            return None
+        
+        return Atom.from_dict({
+            "atom_id": row["atom_id"],
+            "atom_type": row["atom_type"],
+            "content": json.loads(row["content"]),
+            "metadata": json.loads(row["metadata"]),
+            "created_at": row["created_at"],
+            "updated_at": row["updated_at"],
+            "hash_signature": row["hash_signature"]
