+    g = TemporalGraph()
+    nav = NeuralNavigator(graph=g, config=NavigationConfig(enable_telemetry=False))
+    integ = CortexIntegration(event_bus=bus, graph=g, navigator=nav)
+
+    await integ.handle_autonomy_update({"data": {"current_score": 0.9}})
