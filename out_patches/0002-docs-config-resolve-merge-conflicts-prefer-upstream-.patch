+            user_id=user_id,
+            workspace=workspace,
+            task_type=task_type,
+            metadata=metadata
+        )
+        
+        decision = await self.policy_engine.make_decision(policy_id, context)
+        self._metrics["decisions_made"] += 1
+        
+        return decision
+    
+    async def provide_feedback(
+        self,
+        decision_id: str,
+        reward: float,
+        source: str = "manual",
+        **metadata
