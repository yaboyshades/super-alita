-            },
-            "transitions": [
-                {
-                    "from_state": t.from_state,
-                    "to_state": t.to_state,
-                    "trigger": t.trigger,
-                    "type": t.transition_type.value,
-                    "similarity_threshold": t.similarity_threshold,
-                    "priority": t.priority,
-                    "metadata": t.metadata,
