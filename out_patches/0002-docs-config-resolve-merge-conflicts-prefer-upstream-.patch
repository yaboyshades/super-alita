+)
+async def puter_execute(
+    command: str, 
+    args: List[str] = None, 
+    working_dir: str = None, 
+    dry_run: bool = True
+) -> dict[str, Any]:
+    """Execute a command in Puter cloud environment with security validation."""
+    try:
