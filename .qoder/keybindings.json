[
  // MCP Operations
  {
    "key": "ctrl+alt+m",
    "command": "tasks.runTask",
    "args": "alita:mcp:start"
  },
  {
    "key": "ctrl+alt+shift+m",
    "command": "tasks.runTask",
    "args": "alita:mcp:stop"
  },
  {
    "key": "ctrl+alt+t",
    "command": "tasks.runTask",
    "args": "alita:mcp:test"
  },

  // AI Assistant and Code Intelligence
  {
    "key": "ctrl+shift+alt+i",
