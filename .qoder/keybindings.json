    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+space",
    "command": "ai.suggestions.trigger",
    "when": "editorTextFocus"
  },

  // Snippet Optimization Shortcuts
  {
    "key": "ctrl+shift+alt+s",
    "command": "editor.insertSnippet",
    "when": "editorTextFocus && resourceExtname == '.py'"
  },
  {
    "key": "ctrl+shift+alt+o",
    "command": "tasks.runTask",
    "args": "snippet:optimize:current",
    "when": "editorTextFocus && resourceExtname == '.py'"
  },
  {
    "key": "ctrl+shift+alt+e",
    "command": "tasks.runTask",
    "args": "token:efficiency:report"
  },

  // Quick Python snippet insertion
  {
    "key": "ctrl+alt+d",
    "command": "editor.insertSnippet",
    "args": { "name": "def-" },
    "when": "editorTextFocus && resourceExtname == '.py'"
  },
  {
    "key": "ctrl+alt+c",
    "command": "editor.insertSnippet",
    "args": { "name": "class-" },
    "when": "editorTextFocus && resourceExtname == '.py'"
  },
