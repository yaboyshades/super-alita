  "FastAPI SDD Endpoint": {
    "prefix": "sdd-endpoint",
    "body": [
      "@router.${1:post}(\"/${2:endpoint}\")",
      "async def ${3:endpoint_function}(",
      "    ${4:request}: ${5:RequestModel},",
      "    session: AsyncSession = Depends(get_db_session),",
      "    current_user: User = Depends(get_current_user)",
      ") -> ${6:ResponseModel}:",
      "    \"\"\"${7:Endpoint description following SDD patterns}.",
      "    ",
      "    Constitutional Compliance:",
      "    - Library-First: Uses FastAPI and existing validators",
      "    - Test-First: Comprehensive endpoint testing",
      "    - Simplicity: Single purpose endpoint",
      "    - Integration: Follows SDD pipeline patterns",
      "    - Clarity: Clear request/response contract",
      "    - Counterfactual: Proper error handling and validation",
      "    \"\"\"",
      "    try:",
      "        # Constitutional validation",
      "        validation_result = await constitutional_validator.validate(",
      "            request, threshold=0.75",
      "        )",
      "        if not validation_result.is_compliant:",
      "            raise HTTPException(",
      "                status_code=400,",
      "                detail=f\"Constitutional validation failed: {validation_result.violations}\"",
      "            )",
      "        ",
      "        # ${8:Main logic}",
      "        ${9:# Implementation}",
      "        ",
      "        return ${6:ResponseModel}(${10:response_data})",
      "    ",
      "    except Exception as e:",
      "        logger.error(f\"Error in ${3:endpoint_function}: {e}\")",
      "        raise HTTPException(status_code=500, detail=str(e))",
      "    ${0}"
    ],
    "description": "SDD-compliant FastAPI endpoint with constitutional validation"
  },

