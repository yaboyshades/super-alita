  "Spec Kit Constitutional Validator": {
    "prefix": "spec-constitutional",
    "body": [
      "async def validate_${1:component}_spec_kit_compliance(",
      "    specification: Dict[str, Any],",
      "    implementation: Optional[Dict[str, Any]] = None",
      ") -> SpecKitValidationResult:",
      "    \"\"\"Validate Spec Kit compliance against Constitutional Framework.",
      "    ",
      "    Args:",
      "        specification: Spec Kit specification to validate",
      "        implementation: Optional implementation details",
      "    ",
      "    Returns:",
      "        Spec Kit validation result with constitutional scoring",
      "    \"\"\"",
      "    violations = []",
      "    compliance_scores = {}",
      "    ",
      "    # Library-First validation",
      "    library_score = await validate_library_first_compliance(",
      "        specification.get('libraries', []),",
      "        specification.get('patterns', [])",
      "    )",
      "    compliance_scores['library_first'] = library_score",
      "    ",
      "    # Test-First validation",
      "    test_score = await validate_test_first_compliance(",
      "        specification.get('testing_strategy', {}),",
      "        specification.get('acceptance_criteria', [])",
      "    )",
      "    compliance_scores['test_first'] = test_score",
      "    ",
      "    # Simplicity validation",
      "    simplicity_score = await validate_simplicity_compliance(",
      "        specification.get('complexity_metrics', {}),",
      "        specification.get('scope', {})",
      "    )",
      "    compliance_scores['simplicity'] = simplicity_score",
      "    ",
      "    # Integration validation",
      "    integration_score = await validate_integration_compliance(",
      "        specification.get('integration_points', []),",
      "        specification.get('dependencies', [])",
      "    )",
      "    compliance_scores['integration'] = integration_score",
      "    ",
      "    # Clarity validation",
      "    clarity_score = await validate_clarity_compliance(",
      "        specification.get('documentation', {}),",
      "        specification.get('user_stories', [])",
      "    )",
      "    compliance_scores['clarity'] = clarity_score",
      "    ",
      "    # Counterfactual validation",
      "    counterfactual_score = await validate_counterfactual_compliance(",
      "        specification.get('error_handling', {}),",
      "        specification.get('edge_cases', [])",
      "    )",
      "    compliance_scores['counterfactual'] = counterfactual_score",
      "    ",
      "    # Calculate overall compliance",
      "    overall_score = sum(compliance_scores.values()) / len(compliance_scores)",
      "    ",
      "    return SpecKitValidationResult(",
      "        is_compliant=overall_score >= 0.75,",
      "        overall_score=overall_score,",
      "        component_scores=compliance_scores,",
      "        violations=violations,",
      "        spec_kit_version=specification.get('spec_kit_version', 'unknown'),",
      "        constitutional_framework_version='1.0'",
      "    )",
      "    ${0}"
    ],
    "description": "Spec Kit constitutional compliance validator"
  }
