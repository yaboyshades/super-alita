  "Ability Module Template": {
    "prefix": "sdd-ability",
    "body": [
      "\"\"\"${1:AbilityName} - Constitutional AI Ability Module.",
      "",
      "Constitutional Compliance:",
      "- Library-First: Extends existing ability patterns",
      "- Test-First: Comprehensive ability testing",
      "- Simplicity: Single responsibility ability",
      "- Integration: Compatible with orchestration layer",
      "- Clarity: Clear ability interface and purpose",
      "- Counterfactual: Robust error handling and validation",
      "\"\"\"",
      "",
      "from typing import Dict, Any, Optional",
      "from abc import ABC, abstractmethod",
      "",
      "from src.abilities.base_ability import BaseAbility",
      "from src.abilities.validators import AbilityValidator",
      "",
      "",
      "class ${1:AbilityName}Ability(BaseAbility):",
      "    \"\"\"${2:Ability description}.",
      "    ",
      "    Provides ${3:capability_description} following constitutional",
      "    compliance and SDD patterns.",
      "    \"\"\"",
      "    ",
      "    def __init__(self, config: Optional[Dict[str, Any]] = None):",
      "        \"\"\"Initialize ${1:AbilityName}Ability.",
      "        ",
      "        Args:",
      "            config: Configuration dictionary for the ability",
      "        \"\"\"",
      "        super().__init__(config)",
      "        self.validator = AbilityValidator()",
      "        ${4:# Additional initialization}",
      "    ",
      "    async def execute(self, request: Dict[str, Any]) -> Dict[str, Any]:",
      "        \"\"\"Execute the ${1:AbilityName} ability.",
      "        ",
      "        Args:",
      "            request: Request parameters for execution",
      "        ",
      "        Returns:",
      "            Execution results with constitutional compliance info",
      "        \"\"\"",
      "        # Validate request",
      "        validation_result = await self.validator.validate_request(request)",
      "        if not validation_result.is_valid:",
      "            raise ValueError(f\"Invalid request: {validation_result.errors}\")",
      "        ",
      "        try:",
      "            # ${5:Main execution logic}",
      "            ${6:# Implementation}",
      "            ",
      "            # Validate response",
      "            response = {${7:# Response data}}",
      "            response_validation = await self.validator.validate_response(response)",
      "            ",
      "            return {",
      "                \"result\": response,",
      "                \"constitutional_compliance\": response_validation.compliance_score,",
      "                \"execution_metadata\": {",
      "                    \"ability\": \"${1:AbilityName}\",",
      "                    \"timestamp\": self._get_timestamp(),",
      "                    \"version\": self.version",
      "                }",
      "            }",
      "        ",
      "        except Exception as e:",
      "            return self._handle_execution_error(e)",
      "    ${0}"
    ],
    "description": "Constitutional ability module template"
  },

  "Constitutional Validator": {
    "prefix": "sdd-validator",
    "body": [
      "async def validate_${1:component}_constitutional_compliance(",
      "    ${2:input_data}: ${3:InputType},",
      "    threshold: float = 0.75",
      ") -> ConstitutionalValidationResult:",
      "    \"\"\"Validate ${1:component} against Constitutional Framework.",
      "    ",
      "    Args:",
      "        ${2:input_data}: Data to validate",
      "        threshold: Minimum compliance score required",
      "    ",
      "    Returns:",
      "        Constitutional validation result with compliance score",
      "    \"\"\"",
      "    violations = []",
      "    compliance_scores = {}",
      "    ",
      "    # Library-First validation",
      "    ${4:# Check for proper use of existing libraries and patterns}",
      "    ",
      "    # Test-First validation",
      "    ${5:# Verify testability and test coverage}",
      "    ",
      "    # Simplicity validation",
      "    ${6:# Check for single responsibility and minimal complexity}",
      "    ",
      "    # Integration validation",
      "    ${7:# Verify compatibility with existing systems}",
      "    ",
      "    # Clarity validation",
      "    ${8:# Check for clear purpose and documentation}",
      "    ",
      "    # Counterfactual validation",
      "    ${9:# Verify error handling and edge case coverage}",
      "    ",
      "    # Calculate overall compliance score",
      "    overall_score = sum(compliance_scores.values()) / len(compliance_scores)",
      "    ",
      "    return ConstitutionalValidationResult(",
      "        is_compliant=overall_score >= threshold,",
      "        compliance_score=overall_score,",
      "        violations=violations,",
      "        component_scores=compliance_scores",
      "    )",
      "    ${0}"
    ],
    "description": "Constitutional compliance validator"
  },

  "SDD Pipeline Stage": {
    "prefix": "sdd-stage",
    "body": [
      "async def ${1:stage_name}_stage(",
      "    context: SDDContext,",
      "    input_data: ${2:InputType}",
      ") -> ${3:OutputType}:",
      "    \"\"\"${4:Stage description} for SDD pipeline.",
      "    ",
      "    Constitutional Compliance:",
      "    - Library-First: Uses existing SDD patterns and validators",
      "    - Test-First: Comprehensive stage testing",
      "    - Simplicity: Single stage responsibility",
      "    - Integration: Compatible with SDD pipeline",
      "    - Clarity: Clear stage purpose and outputs",
      "    - Counterfactual: Robust error handling and validation",
      "    ",
      "    Args:",
      "        context: SDD execution context",
      "        input_data: Input data for this stage",
      "    ",
      "    Returns:",
      "        Stage output with constitutional compliance info",
      "    \"\"\"",
      "    stage_id = f\"${1:stage_name}_{context.session_id}\"",
      "    logger.info(f\"Starting SDD stage: {stage_id}\")",
      "    ",
      "    try:",
      "        # Pre-stage constitutional validation",
      "        validation_result = await constitutional_validator.validate(",
      "            input_data, stage=\"${1:stage_name}\", threshold=0.75",
      "        )",
      "        ",
      "        if not validation_result.is_compliant:",
      "            raise SDDValidationError(",
      "                f\"Pre-stage validation failed: {validation_result.violations}\"",
      "            )",
      "        ",
      "        # ${5:Main stage logic}",
      "        ${6:# Implementation}",
      "        ",
      "        # Post-stage validation",
      "        output_validation = await constitutional_validator.validate(",
      "            result, stage=\"${1:stage_name}_output\", threshold=0.75",
      "        )",
      "        ",
      "        # Emit stage completion event",
      "        await context.event_emitter.emit(SDDStageCompletedEvent(",
      "            stage_name=\"${1:stage_name}\",",
      "            session_id=context.session_id,",
      "            compliance_score=output_validation.compliance_score,",
      "            duration=time.time() - start_time",
      "        ))",
      "        ",
      "        return ${3:OutputType}(",
      "            data=result,",
      "            constitutional_compliance=output_validation,",
      "            stage_metadata={",
      "                \"stage_id\": stage_id,",
      "                \"execution_time\": time.time() - start_time,",
      "                \"constitutional_score\": output_validation.compliance_score",
      "            }",
      "        )",
      "    ",
      "    except Exception as e:",
      "        logger.error(f\"SDD stage {stage_id} failed: {e}\")",
      "        await context.event_emitter.emit(SDDStageFailedEvent(",
      "            stage_name=\"${1:stage_name}\",",
      "            session_id=context.session_id,",
      "            error=str(e)",
      "        ))",
      "        raise",
      "    ${0}"
    ],
    "description": "SDD pipeline stage with constitutional compliance"
  },

  "Mangle Rule": {
    "prefix": "mangle-rule",
    "body": [
      "def rule_${1:rule_name}(db_path: str) -> List[RuleViolation]:",
      "    \"\"\"${2:Rule description}.",
      "    ",
      "    Constitutional Compliance:",
      "    - Library-First: Uses existing Mangle patterns",
      "    - Test-First: Testable rule logic",
      "    - Simplicity: Single rule responsibility",
      "    - Integration: Compatible with rule engine",
      "    - Clarity: Clear violation detection",
      "    - Counterfactual: Handles edge cases",
      "    ",
      "    Args:",
      "        db_path: Path to Mangle facts database",
      "    ",
      "    Returns:",
      "        List of rule violations found",
      "    \"\"\"",
      "    violations = []",
      "    ",
      "    with sqlite3.connect(db_path) as conn:",
      "        cursor = conn.cursor()",
      "        ",
      "        # ${3:SQL query to detect violations}",
      "        query = \"\"\"",
      "        ${4:SELECT DISTINCT file_path, symbol_name",
      "        FROM symbols s",
      "        JOIN dependencies d ON s.id = d.from_symbol_id",
      "        WHERE ${5:violation_condition}}",
      "        \"\"\"",
      "        ",
      "        cursor.execute(query)",
      "        results = cursor.fetchall()",
      "        ",
      "        for row in results:",
      "            file_path, symbol_name = row",
      "            violations.append(RuleViolation(",
      "                rule_name=\"${1:rule_name}\",",
      "                file_path=file_path,",
      "                symbol_name=symbol_name,",
      "                severity=\"${6:warning|error|info}\",",
      "                message=f\"${7:Violation message for {symbol_name} in {file_path}}\",",
      "                constitutional_impact=\"${8:Constitutional article impacted}\"",
      "            ))",
      "    ",
      "    return violations",
      "    ${0}"
    ],
    "description": "Mangle rule for code quality validation"
  },

