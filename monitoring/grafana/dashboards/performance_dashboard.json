{
  "dashboard": {
    "id": null,
    "title": "Super Alita Performance Monitoring",
    "tags": ["super-alita", "performance", "constitutional"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Extension Response Time (Latency Histogram)",
        "type": "histogram",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(extension_latency_p50_ms[5m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(extension_latency_p95_ms[5m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(extension_latency_p99_ms[5m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Response Time (ms)",
              "axisPlacement": "auto"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 500},
                {"color": "red", "value": 1000}
              ]
            }
          }
        },
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom"},
          "tooltip": {"mode": "single"}
        }
      },
      {
        "id": 2,
        "title": "Error Rate Trend",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(extension_errors_total[5m]) / rate(extension_requests_total[5m]) * 100",
            "legendFormat": "Error Rate %",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 2}
              ]
            },
            "unit": "percent"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "auto"
        }
      },
      {
        "id": 3,
        "title": "Request Throughput",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(extension_requests_total[1m])",
            "legendFormat": "Requests/min",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "green", "value": 10}
              ]
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 4,
        "title": "SLO Compliance Status",
        "type": "stat-panel",
        "targets": [
          {
            "expr": "extension_slo_latency_compliant",
            "legendFormat": "Latency SLO",
            "refId": "A"
          },
          {
            "expr": "extension_slo_error_rate_compliant",
            "legendFormat": "Error Rate SLO",
            "refId": "B"
          }
        ],
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 8},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"options": {"0": {"text": "VIOLATED"}}, "type": "value"},
              {"options": {"1": {"text": "COMPLIANT"}}, "type": "value"}
            ]
          }
        }
      },
      {
        "id": 5,
        "title": "Constitutional Compliance Score",
        "type": "gauge",
        "targets": [
          {
            "expr": "constitutional_compliance_score",
            "legendFormat": "Compliance Score",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 8},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.75},
                {"color": "green", "value": 0.90}
              ]
            },
            "min": 0,
            "max": 1,
            "unit": "percentunit"
          }
        },
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 6,
        "title": "System Resource Utilization",
        "type": "timeseries",
        "targets": [
          {
            "expr": "cpu_usage_percent",
            "legendFormat": "CPU %",
            "refId": "A"
          },
          {
            "expr": "memory_usage_percent",
            "legendFormat": "Memory %",
            "refId": "B"
          }
        ],
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 8},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 85}
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 7,
        "title": "Extension Interaction Timeline",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(extension_requests_total[1m])",
            "legendFormat": "{{extension_id}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Requests/minute",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 10,
              "gradientMode": "none",
              "hideFrom": {"legend": false, "tooltip": false, "vis": false},
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "scaleDistribution": {"type": "linear"},
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {"group": "A", "mode": "none"},
              "thresholdsStyle": {"mode": "off"}
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Recent Alerts",
        "type": "logs",
        "targets": [
          {
            "expr": "{job=\"super-alita\", level=\"ERROR\"}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 22},
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "timepicker": {},
    "templating": {
      "list": [
        {
          "name": "extension",
          "type": "query",
          "query": "label_values(extension_requests_total, extension_id)",
          "current": {"text": "All", "value": "$__all"},
          "options": [],
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "prometheus",
          "enable": true,
          "expr": "deployment_timestamp",
          "iconColor": "rgba(0, 211, 255, 1)",
          "titleFormat": "Deployment"
        }
      ]
    },
    "refresh": "5s",
    "schemaVersion": 30,
    "version": 1,
    "links": []
  }
}