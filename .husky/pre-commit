#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint-staged for staged files
npx lint-staged

# Additional validation for critical files
if git diff --cached --name-only | grep -E "(app\.py|src/main\.py|validate_deployment\.py)"; then
    echo "🎯 Critical files changed, running deployment validation..."
    python validate_deployment.py || {
        echo "❌ Deployment validation failed! Fix issues before committing."
        exit 1
    }
fi

echo "✅ Pre-commit checks passed!"
