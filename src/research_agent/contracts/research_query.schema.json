{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchAgentResult",
  "type": "object",
  "required": ["query", "items", "stats"],
  "properties": {
    "query": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["title", "url", "snippet"],
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "snippet": {"type": "string"}
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["count"],
      "properties": {
        "count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
