{
  "tool_id": "test_calculator",
  "description": "Simple calculator for basic math operations",
  "action": "calculate",
  "input_schema": {
    "type": "object",
    "required": [
      "operation",
      "a",
      "b"
    ],
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "add",
          "subtract",
          "multiply",
          "divide"
        ]
      },
      "a": {
        "type": "number"
      },
      "b": {
        "type": "number"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "number"
      }
    }
  }
}