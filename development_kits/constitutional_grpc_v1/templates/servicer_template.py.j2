        except Exception as e:
            logger.error(f"Error in {{ method.name }}: {e}")
            context.set_code(grpc.StatusCode.INTERNAL)
            context.set_details(f"{{ method.name }} failed: {str(e)}")

            # Return error response with constitutional compliance
            return pb2.{{ method.response_type }}(
