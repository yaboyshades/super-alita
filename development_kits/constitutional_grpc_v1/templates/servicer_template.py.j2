    {% if has_health_check %}
    async def _handle_health_check(
        self,
        request: empty_pb2.Empty,
        context: grpc.ServicerContext
    ) -> pb2.HealthResponse:
        """Handle health check with constitutional validation."""
        # Simple health check implementation
        {% if unified_integration %}
        unified_healthy = self.unified_agent is not None
        mangle_healthy = self.mangle_reasoner is not None

        if unified_healthy and mangle_healthy:
            status = pb2.HealthResponse.HEALTHY
            message = "Constitutional {{ service_name }} service healthy"
        else:
            status = pb2.HealthResponse.DEGRADED
            message = f"Service degraded - unified: {unified_healthy}, mangle: {mangle_healthy}"
        {% else %}
        status = pb2.HealthResponse.HEALTHY
        message = "Constitutional {{ service_name }} service healthy"
        {% endif %}

        return pb2.HealthResponse(
            status=status,
            message=message,
            timestamp={"seconds": int(time.time())},
            constitutional_compliance={
                "framework_version": "1.0",
                "articles_enforced": 14,
                "compliance_score": 1.0,
            }
        )
    {% endif %}

    {% if has_status_check %}
    async def _handle_status_check(
        self,
        request: empty_pb2.Empty,
        context: grpc.ServicerContext
    ) -> pb2.StatusResponse:
        """Handle status check with constitutional metrics."""
        compliance_rate = (
            self._compliance_stats["compliant_requests"] /
            max(self._compliance_stats["total_requests"], 1)
        )

        return pb2.StatusResponse(
            version="{{ service_version }}",
            uptime=int(time.time() - self._start_time),
            system_info={
                "constitutional_framework": "v1.0",
                "service_type": "constitutional_grpc",
                "compliance_rate": f"{compliance_rate:.2%}",
                {% if unified_integration %}
                "unified_agent": "available" if self.unified_agent else "unavailable",
                "mangle_reasoner": "available" if self.mangle_reasoner else "unavailable",
                {% endif %}
            },
            constitutional_compliance={
                "total_requests": self._compliance_stats["total_requests"],
                "compliant_requests": self._compliance_stats["compliant_requests"],
                "violation_count": len(self._compliance_stats["violations"]),
            }
        )
    {% endif %}

    {% if unified_integration %}
    async def _handle_unified_processing(
        self,
        request: Any,
        context: grpc.ServicerContext
    ) -> Any:
        """Process request via unified intelligence layer."""
        if not self.unified_agent:
            raise RuntimeError("Unified agent not available")

        # Convert gRPC request to unified intelligence format
        unified_request = self._convert_to_unified_format(request)

        # Process via unified intelligence
        result = await self.unified_agent.process(unified_request)

        # Convert back to gRPC response format
        response = self._convert_to_grpc_format(result)

        # Add constitutional compliance metadata
        response.constitutional_compliance = {
            "processed_via": "unified_intelligence",
            "compliant": True,
            "articles_validated": ["I", "II", "III", "IV", "V"],
        }

        return response

    def _convert_to_unified_format(self, grpc_request: Any) -> dict[str, Any]:
        """Convert gRPC request to unified intelligence format."""
        # Implementation depends on specific message types
        return {
            "content": str(grpc_request),
            "metadata": {
                "source": "constitutional_grpc",
                "service": "{{ service_name }}",
            }
        }

    def _convert_to_grpc_format(self, unified_result: dict[str, Any]) -> Any:
        """Convert unified intelligence result to gRPC response."""
        # Implementation depends on specific response types
        # This is a template placeholder
        return pb2.ProcessingResponse(
            success=True,
            result=str(unified_result),
            metadata=unified_result.get("metadata", {}),
        )
    {% endif %}

