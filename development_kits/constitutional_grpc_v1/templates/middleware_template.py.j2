def calculate_constitutional_score(payload: Any, context: str = "general") -> float:
    """
    Standalone function to calculate constitutional score for any payload.

    Used by servicers for direct constitutional validation.

    Args:
        payload: The payload to score
        context: Context for scoring (request/response/general)

    Returns:
        Constitutional compliance score (0.0-1.0)
    """
    # Simplified scoring for standalone use
    base_score = 0.75

    # Simple heuristics for constitutional compliance
    if hasattr(payload, 'DESCRIPTOR'):
        base_score += 0.15  # Standard protobuf

    if hasattr(payload, '__dict__'):
        field_count = len(payload.__dict__)
        if field_count <= 10:
            base_score += 0.10  # Simple structure

    return min(1.0, base_score)
