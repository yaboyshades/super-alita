@dataclass
class ConstitutionalScore:
    """
    Constitutional compliance score for a request/response.

    Implements Article V: Clarity through explicit scoring structure.
    """

    overall_score: float
    article_scores: Dict[str, float]
    violations: list[str]
    compliance_threshold: float = {{ constitutional_threshold }}

    @property
    def is_compliant(self) -> bool:
        """Check if score meets constitutional compliance threshold."""
        return self.overall_score >= self.compliance_threshold

    @property
    def violation_summary(self) -> str:
        """Generate human-readable violation summary."""
        if not self.violations:
            return "No constitutional violations detected"

        return f"Constitutional violations: {', '.join(self.violations)}"

    def to_dict(self) -> Dict[str, Any]:
        """Convert score to dictionary for logging/monitoring."""
        return {
            "overall_score": self.overall_score,
            "article_scores": self.article_scores,
            "violations": self.violations,
            "is_compliant": self.is_compliant,
            "threshold": self.compliance_threshold,
        }


